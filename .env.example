# Copy to `.env` and fill in. Everything here is also what the deployed server
# needs — paste the server-side keys into your host's environment (Railway:
# Variables → Raw Editor).

# ─── Server ──────────────────────────────────────────────────────────────────
# Direct TCP connection string for Prisma Postgres (from the Prisma dashboard).
# The pg driver adapter needs the direct `postgres://…@db.prisma.io` URL — NOT
# the `prisma+postgres://` Accelerate URL.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Clerk. Both are read at import time by apps/server/src/middleware/auth.ts, so a
# missing or EMPTY value crash-loops the server on boot rather than 500ing.
# SECRET — server only. Never goes near the CLI or a release build.
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Model providers. Not validated at boot — a missing key surfaces as a 500
# mid-stream on POST /chat/:sessionId.
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-proj-..."          # only needed for the gpt-5.1 registry entry

# Optional. Defaults to 3001 (not 3000, to dodge a Next.js dev server).
# Hosts that inject their own PORT will override this.
# PORT=3001

# ─── CLI ─────────────────────────────────────────────────────────────────────
# Public Clerk config for the OAuth /login flow (public PKCE client — not secret).
CLERK_FRONTEND_API="https://your-app.clerk.accounts.dev"
CLERK_OAUTH_CLIENT_ID="..."

# Which server the CLI talks to. Protocol included, NO trailing slash. Defaults
# to http://localhost:3001 when unset. `bun run build:cli` bakes this value (and
# the two CLERK_ vars above) into the release bundle — see
# apps/cli/scripts/build.ts.
SERVER_URL="https://your-app.up.railway.app"
